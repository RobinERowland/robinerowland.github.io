# ----------------------------
# Server
# ----------------------------
server <- function(input, output, session) {
roost_map <- c(
"Buildings" = "Buildings",
"Caves" = "Caves",
"Tree Crevices" = "Tree Crevices",
"Mines" = "Mines",
"Bat Boxes" = "Bat Boxes",
"Water/Transport Infrastructure" = "Water/Transport Infrastructure",
"Foliage" = "Foliage",
"Vegetation Bird Nests" = "Vegetation Bird Nests",
"Mud Bird Nests" = "Mud Bird Nests",
"Fabric" = "Fabric"
)
filtered_data <- reactive({
df <- apply_epbc_overrides(bat_trait_data, input$state_filter)
if (input$state_filter != "All") {
df <- df[grepl(input$state_filter, df$State, fixed = TRUE), ]
}
if (input$family_filter != "All") {
df <- df[df$Family == input$family_filter, ]
}
if (input$epbc_filter != "All") {
status_vals <- as.character(df$`EPBC Act Status`)
df <- df[!is.na(status_vals) & startsWith(status_vals, input$epbc_filter), ]
}
if (input$roost_filter != "All") {
roost_col <- roost_map[[input$roost_filter]]
if (!is.null(roost_col) && roost_col %in% names(df)) {
df <- df[df[[roost_col]] == "Yes", ]
}
}
df
})
output$stat_species <- renderText({
format(nrow(filtered_data()), big.mark = ",")
})
output$stat_families <- renderText({
df <- filtered_data()
if (!"Family" %in% names(df)) return("0")
length(unique(df$Family[!is.na(df$Family) & trimws(df$Family) != ""]))
})
output$stat_no_roost <- renderText({
df <- filtered_data()
if (!"Roost Types" %in% names(df)) return("0")
roost_vals <- df$`Roost Types`
sum(
is.na(roost_vals) |
str_to_lower(str_squish(as.character(roost_vals))) == "na" |
str_squish(as.character(roost_vals)) == "",
na.rm = TRUE
)
})
output$stat_grid <- renderUI({
show_no_roost <- identical(input$roost_filter, "All")
div(
class = "stat-grid",
div(
class = "stat-box",
span(class = "stat-num", textOutput("stat_species", inline = TRUE)),
span(class = "stat-label", "Total Species")
),
div(
class = "stat-box",
span(class = "stat-num", textOutput("stat_families", inline = TRUE)),
span(class = "stat-label", "Total Families")
),
if (show_no_roost) {
div(
class = "stat-box",
span(class = "stat-num", textOutput("stat_no_roost", inline = TRUE)),
span(class = "stat-label", "No Known Roosts")
)
}
)
})
output$roost_pie_chart <- renderPlotly({
df <- filtered_data()
roost_cols <- unname(roost_map)
# Calculate total occurrences of each roost type in the filtered dataset
counts <- sapply(roost_cols, function(col) {
if (col %in% names(df)) {
sum(df[[col]] == "Yes", na.rm = TRUE)
} else {
0
}
})
pie_df <- data.frame(
Roost = names(counts),
Count = as.numeric(counts),
stringsAsFactors = FALSE
)
# Keep only roost types present in the filtered data
pie_df <- pie_df[pie_df$Count > 0, ]
# Return empty plot if no data matches
if (nrow(pie_df) == 0) {
return(
plotly_empty(type = "pie") %>%
layout(
paper_bgcolor = 'transparent',
plot_bgcolor = 'transparent',
annotations = list(
text = "No roost data",
showarrow = FALSE,
font = list(size = 11, color = "#6B6A5D")
)
)
)
}
# Map colors from your roost_palette
slice_colors <- unname(roost_palette[pie_df$Roost])
plot_ly(
pie_df,
labels = ~Roost,
values = ~Count,
type = 'pie',
textinfo = 'none',
hoverinfo = 'label+value+percent',
marker = list(colors = slice_colors),
showlegend = FALSE
) %>%
layout(
margin = list(l = 8, r = 8, t = 8, b = 8),
paper_bgcolor = 'transparent',
plot_bgcolor = 'transparent',
xaxis = list(showgrid = FALSE, zeroline = FALSE, showticklabels = FALSE),
yaxis = list(showgrid = FALSE, zeroline = FALSE, showticklabels = FALSE)
) %>%
config(displayModeBar = FALSE)
})
output$download_filtered <- downloadHandler(
filename = function() paste0("australian_bat_roost_data_filtered_", Sys.Date(), ".csv"),
content = function(file) write.csv(filtered_data(), file, row.names = FALSE)
)
output$download_all <- downloadHandler(
filename = function() paste0("australian_bat_roost_data_complete_", Sys.Date(), ".csv"),
content = function(file) write.csv(bat_trait_data, file, row.names = FALSE)
)
output$download_functional_traits <- downloadHandler(
filename = function() paste0("australian_bat_functional_traits_", Sys.Date(), ".csv"),
content = function(file) write.csv(functional_traits, file, row.names = FALSE)
)
output$data_table <- renderDT({
display_data <- filtered_data()
cols_to_hide <- c(
"Buildings", "Water/Transport Infrastructure", "Fabric", "Bat Boxes",
"Mines", "Caves", "Tree Crevices", "Foliage", "Vegetation Bird Nests",
"Mud Bird Nests", "Sources", "State"
)
cols_to_hide <- cols_to_hide[cols_to_hide %in% names(display_data)]
col_indices <- which(names(display_data) %in% cols_to_hide) - 1
dt <- datatable(
display_data,
selection = "single",
options = list(
scrollX = TRUE,
scrollY = "100%",
scrollCollapse = TRUE,
pageLength = 50,
autoWidth = FALSE,
dom = 't<"dt-footer"p<"inline-hint-text"i>>',
columnDefs = list(
list(visible = FALSE, targets = col_indices)
)
),
rownames = FALSE,
class = "stripe hover"
) %>%
formatStyle(
columns = names(display_data),
`white-space` = "nowrap",
`overflow` = "hidden",
`text-overflow` = "ellipsis",
`max-width` = "250px",
backgroundColor = "#FFFFFF",
color = "#24231D"
) %>%
formatStyle(
'Scientific Name',
fontStyle = 'italic'
)
if ("EPBC Act Status" %in% names(display_data)) {
dt <- dt %>% formatStyle(
"EPBC Act Status",
color = styleEqual(names(status_palette), unname(status_palette)),
fontWeight = "600"
)
}
if ("IUCN Status" %in% names(display_data)) {
dt <- dt %>% formatStyle(
"IUCN Status",
color = styleEqual(names(status_palette), unname(status_palette)),
fontWeight = "600"
)
}
dt
})
observeEvent(input$data_table_rows_selected, {
if (length(input$data_table_rows_selected) > 0) {
row_idx <- input$data_table_rows_selected
species_data <- filtered_data()[row_idx, ]
species_name <- species_data$`Scientific Name`
if (is.null(species_name) || is.na(species_name) || species_name == "") species_name <- species_data[[1]]
common_name <- species_data$`Common Name`
if (is.na(common_name) || common_name == "") common_name <- "Not available"
preferred_roost <- species_data$`Preferred Roosts`
if (is.na(preferred_roost) || preferred_roost == "") preferred_roost <- "Not available"
known_roosts <- species_data$`Known Roost Types`
if (is.na(known_roosts) || known_roosts == "") known_roosts <- "No roost types listed."
anthro_roost <- species_data$`Anthropogenic Roosting`
if (is.na(anthro_roost) || anthro_roost == "") anthro_roost <- "Not available"
notes <- species_data$Notes
if (is.na(notes) || notes == "") notes <- "No notes available."
sources <- species_data$Sources
if (is.na(sources) || sources == "") sources <- "No sources available."
epbc_status <- species_data$`EPBC Act Status`
if (is.na(epbc_status) || epbc_status == "") epbc_status <- "Not available"
iucn_status <- species_data$`IUCN Status`
if (is.na(iucn_status) || iucn_status == "") iucn_status <- "Not available"
field <- function(label, content_ui) {
tagList(
h4(label, style = "color: var(--ink-soft); font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.08em; text-transform:uppercase; font-weight:600; margin-top:0;"),
div(style = "margin-bottom: 20px; color: var(--ink); line-height:1.55; white-space: pre-wrap; word-wrap: break-word; text-align: left !important;", content_ui)
)
}
showModal(
modalDialog(
title = tags$em(tags$span(style = "font-family:'Fraunces',serif; font-weight:600; font-size:22px;", species_name)),
div(
style = "max-height: 500px; overflow-y: auto;",
field("Common name", common_name),
field("Preferred roosts", preferred_roost),
field("Known roost types", known_roosts),
field("Anthropogenic roosting", anthro_roost),
field("Notes", notes),
field("Sources", sources),
field("EPBC Act status", epbc_status),
field("IUCN status", iucn_status)
),
easyClose = TRUE,
footer = modalButton("Close"),
size = "l"
)
)
}
})
output$functional_traits_table <- renderDT({
datatable(
functional_traits,
options = list(
scrollX = TRUE,
scrollY = "100%",
scrollCollapse = TRUE,
pageLength = 50,
autoWidth = TRUE,
dom = 't<"dt-footer"p>'
),
rownames = FALSE,
width = "100%",
class = "stripe hover"
) %>%
formatStyle(
columns = names(functional_traits),
`white-space` = "nowrap",
`overflow` = "hidden",
`text-overflow` = "ellipsis",
`max-width` = "250px"
)
})
}
shinyApp(ui = ui, server = server)
runApp()
