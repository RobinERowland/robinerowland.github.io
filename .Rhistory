display: flex;
flex-wrap: wrap;
justify-content: space-between;
padding: 12px 10px !important;
}
/* Force the 4 dropdowns to sit side-by-side to save massive space */
.well > .form-group {
width: 48%;
margin-bottom: 4px !important;
}
/* Smaller fonts for filters strictly on mobile */
.well .control-label {
font-size: 9.5px !important;
margin-bottom: 2px !important;
}
.well .form-select, .well .form-control {
font-size: 11px !important;
padding: 2px 6px !important;
}
/* Ensure stats, buttons, and pie chart span the full width below the dropdowns */
.well > div:not(.form-group) {
width: 100%;
}
/* Hide the summary stat boxes (Total Species / Families / etc.) on mobile */
.stat-grid { display: none !important; }
/* Hide the pie chart on mobile to save vertical space in the filter box */
#roost_pie_chart { display: none !important; }
/* Download buttons: on mobile these get moved (via JS) to sit below the
table, inside the .app-card. Style them to lay out side-by-side there. */
#download-buttons-wrapper {
flex-direction: row !important;
gap: 6px !important;
flex: 0 0 auto;
margin-top: 8px !important;
}
.app-card #download-buttons-wrapper {
margin-top: 10px;
padding-top: 10px;
border-top: 1px solid var(--line);
}
#download-buttons-wrapper .shiny-download-link {
width: auto;
flex: 1 1 0;
text-align: center;
}
/* Table and smaller fonts for mobile */
table.dataTable { font-size: 11px !important; }
.nav-tabs .nav-link { margin-right: 10px; font-size: 11px; }
.inline-hint-text { margin-left: 0; width: 100%; text-align: center; }
}
")),
tags$script(HTML("
(function() {
function adjustDataTables() {
$('.app-card .dataTables_wrapper table.dataTable').each(function() {
$.fn.dataTable.Api(this).columns.adjust();
});
}
var resizeTimer;
$(window).on('resize', function() {
clearTimeout(resizeTimer);
resizeTimer = setTimeout(adjustDataTables, 150);
});
$(document).on('shiny:value', function(e) {
if (e.name === 'data_table' || e.name === 'functional_traits_table') {
setTimeout(adjustDataTables, 100);
}
});
$(document).on('shown.bs.tab', '[data-bs-toggle=\"tab\"]', function() {
setTimeout(adjustDataTables, 80);
});
// ------------------------------------------------------------
// Move the download-buttons block below the table on mobile,
// and restore it to the sidebar on desktop-width screens.
// ------------------------------------------------------------
function positionDownloadButtons() {
var wrapper = document.getElementById('download-buttons-wrapper');
var tableCard = document.getElementById('roost-table-card');
var anchor = document.getElementById('download-buttons-anchor');
if (!wrapper || !tableCard || !anchor) return;
var isMobile = window.matchMedia('(max-width: 768px)').matches;
if (isMobile) {
if (wrapper.parentElement !== tableCard) {
tableCard.appendChild(wrapper);
adjustDataTables();
}
} else {
if (wrapper.previousElementSibling !== anchor) {
anchor.parentNode.insertBefore(wrapper, anchor.nextSibling);
adjustDataTables();
}
}
}
$(document).on('shiny:sessioninitialized', function() {
setTimeout(positionDownloadButtons, 50);
});
window.addEventListener('resize', function() {
clearTimeout(window._dlBtnResizeTimer);
window._dlBtnResizeTimer = setTimeout(positionDownloadButtons, 150);
});
document.addEventListener('DOMContentLoaded', positionDownloadButtons);
})();
"))
),
